# ============================================================
# BUILD-TIME — must be set on the machine that runs the build.
# NEXT_PUBLIC_* values are inlined into the bundle at build time, so putting
# them on the server does nothing.
# ============================================================

# The production origin, no trailing slash. Everything canonical is built from
# it: <link rel="canonical">, Open Graph URLs, the JSON-LD @id graph,
# sitemap.xml and robots.txt. Get this wrong and every one of them points at
# the wrong domain.
#
# Optional in practice: src/lib/site.js hardcodes the production domain as a
# fallback, so a build without this still emits correct URLs. Set it only if
# the domain changes, or when building a staging copy.
NEXT_PUBLIC_SITE_URL=https://portfolio.fauzanahsan.my.id

# ============================================================
# RUNTIME — read by the server process on each request.
# In production these live in ~/.config/portfolio/env on the server and are
# loaded by the systemd unit's EnvironmentFile. See DEPLOY.md.
# ============================================================

# Server-only. Used by src/app/api/chat/route.js for the AI assistant.
#
# Any OpenAI-compatible endpoint works. This default assumes 9router is
# running on the same host as the Node server. Set AI_BASE_URL explicitly
# when the gateway runs on another host; do not expose it publicly.
AI_BASE_URL=http://127.0.0.1:20128/v1

# The bearer token for the endpoint above. Without it the route returns a
# friendly fallback instead of erroring, so the site still works.
AI_API_KEY=

# Model ids exactly as the endpoint reports them in GET /v1/models — they are
# not interchangeable with provider-native names. Measured on 9router:
#   gemini/gemini-3.5-flash-lite  ~1s   correct English, clean output   <- default
#   gemini/gemini-3.6-flash       ~3s   accurate but weak verb forms   <- fallback
#   gemini/gemini-3.8-flash       6-18s and returned 503 intermittently
#   gemini/gemini-3.7-flash       26-44s
#   openrouter/openrouter/free    broken — always returns empty content
AI_MODEL=gemini/gemini-3.5-flash-lite
AI_MODEL_FALLBACKS=gemini/gemini-3.6-flash

# Per-attempt timeout in milliseconds. The route walks the fallback list on
# timeout, so worst case is (1 + len(fallbacks)) x this value before the
# built-in local answers take over.
AI_TIMEOUT_MS=20000

# Content lives in src/data/portfolio.json — there is no data API to configure.
# Edit that file (or run ./scripts/edit.sh), rebuild, redeploy.
