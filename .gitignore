# ============================================
# MUST COMMIT (do NOT ignore):
# - src/app/**          (routes, layout, API route handlers)
# - src/components/**   (UI)
# - public/**           (images, audio, favicon)
# - next.config.mjs, jsconfig.json, package.json
# - .env.example        (environment template)
# ============================================

